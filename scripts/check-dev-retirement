#!/usr/bin/env python3
"""Prove old app cleanup can run off the next-build path without being lost."""
from pathlib import Path
import subprocess
import tempfile

repo = Path(__file__).resolve().parents[1]
with tempfile.TemporaryDirectory(prefix="caramel-retirement-", dir="/private/tmp") as temporary:
    root = Path(temporary)
    (root / "resistant.py").write_text("import os,signal,time\nfrom pathlib import Path\nsignal.signal(signal.SIGTERM,signal.SIG_IGN)\nPath('ready').write_text(str(os.getpid()))\nwhile True: time.sleep(1)\n")
    runner = root / "runner"
    subprocess.run([str(repo / "scripts/crystal"), "build", "spec/fixtures/dev_retirement.cr", "-o", str(runner)], cwd=repo, check=True)
    subprocess.run([str(runner), str(root)], check=True, timeout=20)
    pid = int((root / "ready").read_text())
    status = subprocess.run(["/bin/ps", "-p", str(pid), "-o", "stat="], text=True, capture_output=True, check=False).stdout.strip()
    assert not status or status.startswith("Z"), "TERM-resistant command survived retirement"
    print("PASS: TERM-resistant command did not survive completed retirement", flush=True)
