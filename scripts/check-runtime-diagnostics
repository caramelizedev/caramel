#!/usr/bin/env python3
"""Prove detailed errors require a development build AND development runtime."""
from pathlib import Path
import json
import os
import re
import subprocess
import tempfile

repo = Path(__file__).resolve().parents[1]
fixture = repo / "spec/fixtures/runtime_errors"
marker = "CARAMEL DEVELOPMENT EXCEPTION"
env = {**os.environ, "CARAMEL_PROJECT_ROOT": str(fixture), "APP_SECRET": "s" * 64,
       "DATABASE_URL": "postgresql://user:database-secret@private-host/app"}
with tempfile.TemporaryDirectory(prefix="caramel-errors-", dir="/private/tmp") as directory:
    root = Path(directory)
    for mode in ("production", "development"):
        binary = root / mode
        command = [str(repo / "scripts/crystal"), "build", str(fixture / "main.cr"), "-o", str(binary)]
        if mode == "development":
            command += ["-D", "caramel_development"]
        subprocess.run(command, cwd=repo, check=True)
        assert (marker.encode() in binary.read_bytes()) == (mode == "development"), "development diagnostic code must be absent from production binary"
        for environment in ("production", "development", "test"):
            for partial in (False, True):
                result = subprocess.run([str(binary), *(["partial"] if partial else [])], env={**env, "CARAMEL_ENV": environment}, capture_output=True, text=True, check=True)
                response = json.loads(result.stdout)
                body = response["body"]
                assert response["status"] == 500
                assert re.fullmatch(r"[0-9a-f-]{36}", response["headers"]["X-Request-ID"][0])
                for secret in ("s" * 64, "private-password", "database-secret"):
                    assert secret not in body, "secret was reflected in diagnostics"
                if mode == environment == "development":
                    assert marker in body and "Missing helper &lt;unsafe&gt;" in body
                    assert re.search(r"app/controller\.cr:\d+", body), body
                    assert re.search(r"app/controller\.cr:\d+", body.split("<details>")[0]), body
                    assert "Internal stack frames" in body and "<details>" in body
                    assert ("<!DOCTYPE html>" in body) != partial
                else:
                    assert marker not in body and "Missing helper" not in body
                    assert "Something went wrong" in body
        print("PASS: " + mode + " build error visibility and redaction", flush=True)
