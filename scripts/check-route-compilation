#!/usr/bin/env python3
"""Verify route declarations are checked against action contracts at compile time."""
from pathlib import Path
import subprocess

REPO = Path(__file__).resolve().parents[1]
# Each failing case lists (required, forbidden) stderr substrings.
cases = {
    "compile_valid": None,
    "compile_missing_contract_field": (["ROUTE CONTRACT MISMATCH", "is missing 'field team_id : Type'", "compile_missing_contract_field.cr:", "Remediation: add `field team_id : Int64` to the contract block of TeamShow."], []),
    "compile_wrong_param_type": (["ROUTE CONTRACT TYPE MISMATCH", "compile_wrong_param_type.cr:", "Remediation: declare `field team_id : Int64`"], []),
    "compile_nilable_param": (["ROUTE CONTRACT TYPE MISMATCH", "team_id : Int64?", "Remediation:"], []),
    "compile_undefined_action": (["Action 'Missing::Show' is undefined", "compile_undefined_action.cr:"], []),
    "compile_not_action": (["must inherit from Caramel::Action", "Remediation:"], []),
    "compile_missing_contract": (["must define an explicit `contract do ... end` block", "Remediation:"], []),
    "compile_duplicate_route": (["DUPLICATE ROUTE", 'get "/teams/:id", TeamOther'], ["__caramel_router_draw"]),
    "compile_ambiguous_order": (["AMBIGUOUS ROUTE ORDER", 'get "/teams/new", TeamNew'], ["__caramel_router_draw"]),
    "compile_unknown_verb": (["accepts only get, post, put, patch and delete", "resources :books"], ["__caramel_router_draw"]),
    "compile_wrong_path_id": (["expected argument #1"], []),
}
for name, expectation in cases.items():
    result = subprocess.run([str(REPO / "scripts/crystal"), "build",
                             "spec/fixtures/routes/" + name + ".cr", "--no-codegen"],
                            cwd=REPO, capture_output=True, text=True, timeout=90)
    output = name + "\n" + result.stdout + result.stderr
    if expectation is None:
        assert result.returncode == 0, output
    else:
        required, forbidden = expectation
        assert result.returncode != 0, output
        for text in required:
            assert text in result.stderr, "missing " + repr(text) + " in " + output
        for text in forbidden:
            assert text not in result.stderr, "unexpected " + repr(text) + " in " + output
    print("PASS: " + name)
