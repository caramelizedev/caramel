<h1>Islands</h1>
<div id="island-panel" class="probe-panel"><%= counter %></div>
<button id="island-morph" type="button" hx-get="/probe/islands/panel?label=second&amp;version=2">Re-render with new props</button>
<button id="island-remove" type="button" hx-get="/probe/islands/panel?label=gone&amp;version=3&amp;remove=true">Remove the island</button>
<div id="late-panel" class="probe-panel"><%= late %></div>
<button id="define-late" type="button">Define LateProbe</button>
