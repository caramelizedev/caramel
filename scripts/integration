#!/usr/bin/env python3
"""Run Crystal integration specs against a fresh, privately owned PostgreSQL cluster."""
import os
from pathlib import Path
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
from urllib.parse import urlencode, quote

REPO = Path(__file__).resolve().parent.parent
root = os.environ.get("CARAMEL_TOOLCHAIN_ROOT")
if not root:
    sys.exit("Set CARAMEL_TOOLCHAIN_ROOT to the verified contributor installation.")
installs = Path(root).resolve() / "data/installs"
pg = installs / "conda-postgresql/18.6/bin"
openssl = installs / "conda-openssl/3.6.4/bin/openssl"
if not (pg / "initdb").is_file() or not openssl.is_file():
    sys.exit("Managed PostgreSQL or OpenSSL is missing; rerun scripts/install-toolchain for CARAMEL_TOOLCHAIN_ROOT.")
owned = Path(tempfile.mkdtemp(prefix="caramel-integration-", dir="/private/tmp"))
owned.chmod(0o700)
data = owned / "data"
sock = owned / "socket"
sock.mkdir(mode=0o700)
with socket.socket() as reservation:
    reservation.bind(("127.0.0.1", 0))
    port = reservation.getsockname()[1]
# Clear libpq defaults so the harness cannot connect to a user's existing DB.
env = {k: v for k, v in os.environ.items() if not k.startswith("PG") and not k.startswith("CARAMEL_OWNED_")}
env["LC_ALL"] = "C"
started = False
failed = False

def run(args, **kwargs):
    return subprocess.run([str(a) for a in args], env=env, check=True, timeout=120, **kwargs)

def quiet(args):
    return run(args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)

def db_url(database, user, password, host, ca=None):
    query = {"host": str(host), "port": str(port), "sslmode": "verify-full" if ca else "disable"}
    if ca:
        query["sslrootcert"] = str(ca)
    return "postgresql://" + user + ":" + quote(password, safe="") + "@/" + database + "?" + urlencode(query)

try:
    quiet([pg / "initdb", "-D", data, "--username=caramel_admin", "--encoding=UTF8", "--locale=C", "--auth-local=trust", "--auth-host=scram-sha-256"])
    for name in ("ca", "untrusted"):
        quiet([openssl, "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "1", "-subj", "/CN=Caramel integration " + name, "-keyout", owned / (name + ".key"), "-out", owned / (name + ".crt")])
    quiet([openssl, "req", "-newkey", "rsa:2048", "-nodes", "-subj", "/CN=localhost", "-keyout", owned / "server.key", "-out", owned / "server.csr"])
    (owned / "server.ext").write_text("subjectAltName=DNS:localhost\nextendedKeyUsage=serverAuth\n")
    quiet([openssl, "x509", "-req", "-in", owned / "server.csr", "-CA", owned / "ca.crt", "-CAkey", owned / "ca.key", "-CAcreateserial", "-days", "1", "-extfile", owned / "server.ext", "-out", owned / "server.crt"])
    (owned / "server.key").chmod(0o600)
    with (data / "postgresql.conf").open("a") as config:
        config.write("\nlisten_addresses = '127.0.0.1'\nport = " + str(port) + "\nunix_socket_directories = '" + str(sock) + "'\nssl = on\nssl_cert_file = '" + str(owned / "server.crt") + "'\nssl_key_file = '" + str(owned / "server.key") + "'\ntimezone = 'UTC'\n")
    run([pg / "pg_ctl", "-D", data, "-l", owned / "postgres.log", "-w", "start"], stdout=subprocess.DEVNULL)
    started = True
    password = secrets.token_hex(24)
    sql = "\n".join([
        "CREATE ROLE caramel_spec LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD '" + password + "';",
        "CREATE ROLE caramel_dev LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD '" + password + "';",
        "CREATE ROLE caramel_model_spec LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD '" + password + "';",
        "CREATE DATABASE caramel_spec OWNER caramel_spec;",
        "CREATE DATABASE caramel_development OWNER caramel_dev;",
        "REVOKE CONNECT ON DATABASE caramel_spec FROM PUBLIC;",
        "REVOKE CONNECT ON DATABASE caramel_development FROM PUBLIC;",
        "GRANT CONNECT ON DATABASE caramel_spec TO caramel_model_spec;",
    ])
    run([pg / "psql", "-X", "-v", "ON_ERROR_STOP=1", "-h", sock, "-p", port, "-U", "caramel_admin", "-d", "postgres"], input=sql, text=True, stdout=subprocess.DEVNULL)
    env.update({
        "CARAMEL_OWNED_SPEC_URL": db_url("caramel_spec", "caramel_spec", password, sock),
        "CARAMEL_OWNED_MODEL_RUNTIME_URL": db_url("caramel_spec", "caramel_model_spec", password, sock),
        "CARAMEL_OWNED_DEV_URL": db_url("caramel_development", "caramel_dev", password, sock),
        "CARAMEL_OWNED_TLS_URL": db_url("caramel_spec", "caramel_spec", password, "localhost", owned / "ca.crt"),
        "CARAMEL_OWNED_WRONG_HOST_URL": db_url("caramel_spec", "caramel_spec", password, "127.0.0.1", owned / "ca.crt"),
        "CARAMEL_OWNED_UNTRUSTED_URL": db_url("caramel_spec", "caramel_spec", password, "localhost", owned / "untrusted.crt"),
    })
    result = subprocess.run([str(REPO / "scripts/crystal"), "spec", "spec/integration", "--error-trace", *sys.argv[1:]], cwd=REPO, env=env)
    failed = result.returncode != 0
except (subprocess.CalledProcessError, subprocess.TimeoutExpired, KeyboardInterrupt) as exc:
    print("Integration harness failed: " + type(exc).__name__, file=sys.stderr)
    failed = True
finally:
    # The cluster path was created by this invocation. Never inspect/stop other clusters.
    if started or (data / "postmaster.pid").exists():
        stopped = subprocess.run([str(pg / "pg_ctl"), "-D", str(data), "-m", "fast", "-w", "stop"], env=env, stdout=subprocess.DEVNULL, timeout=30)
        if stopped.returncode:
            print("Could not stop owned PostgreSQL cluster; retained at " + str(owned), file=sys.stderr)
            failed = True
        else:
            shutil.rmtree(owned)
    else:
        shutil.rmtree(owned)
sys.exit(1 if failed else 0)
