#!/usr/bin/env python3
"""Contributor compiler entry point; consumer installation is owned by Latte."""
import os
from pathlib import Path
import shutil
import sys

env = os.environ.copy()
root = env.get("CARAMEL_TOOLCHAIN_ROOT")
args = sys.argv[1:]
if root:
    base = Path(root).resolve()
    installs = base / "data/installs"
    crystal_root = installs / "github-crystal-lang-crystal/1.21.0"
    # Use the native compiler directly. macOS strips loader variables when
    # passing through the distribution's system-shell wrapper.
    compiler = crystal_root / "embedded/bin/crystal"
    env.setdefault("CRYSTAL_PATH", "lib:" + str(crystal_root / "src"))
    env["CRYSTAL_LIBRARY_PATH"] = ":".join(filter(None, (env.get("CRYSTAL_LIBRARY_PATH"), str(crystal_root / "embedded/lib"))))
    openssl = installs / "conda-openssl/3.6.4"
    env["PATH"] = str(base / "bin") + ":" + env.get("PATH", "")
    env["PKG_CONFIG_LIBDIR"] = str(openssl / "lib/pkgconfig")
    env["CRYSTAL_CACHE_DIR"] = str(base / "crystal-cache")
    if args and args[0] == "eval":
        # eval has no linker-options flag and immediately executes its output.
        # Scope the loader path to this child process, without global changes.
        env["DYLD_LIBRARY_PATH"] = ":".join(filter(None, (str(openssl / "lib"), env.get("DYLD_LIBRARY_PATH"))))
    if args and args[0] in ("build", "run", "spec"):
        flag = "--link-flags=-Wl,-rpath," + str(openssl / "lib")
        # These commands support link flags; eval does not accept that option.
        args.insert(1, flag)
else:
    compiler = shutil.which("crystal")
if not compiler or not Path(compiler).is_file() or Path(compiler).resolve() == Path(__file__).resolve():
    sys.exit("Crystal is unavailable. Set CARAMEL_TOOLCHAIN_ROOT to the verified installation (see experiments/toolchain/README.md).")
os.execve(str(compiler), [str(compiler), *args], env)
