#!/usr/bin/env python3
"""Verify invalid route/controller/path bindings fail at compile time."""
from pathlib import Path
import subprocess

REPO = Path(__file__).resolve().parents[1]
cases = {
    "compile_missing_action": "undefined method 'show'",
    "compile_wrong_id_type": "expected argument #1",
    "compile_wrong_path_id": "expected argument #1",
}
for name, error in cases.items():
    result = subprocess.run([str(REPO / "scripts/crystal"), "build",
                             "spec/fixtures/routes/" + name + ".cr", "--no-codegen"],
                            cwd=REPO, capture_output=True, text=True, timeout=90)
    assert result.returncode != 0 and error in result.stderr, name + "\n" + result.stdout + result.stderr
    print("PASS: " + name)
