#!/usr/bin/env python3
"""Separate Crystal compiler phases using disposable generated applications.

Each scenario has an isolated empty compiler cache backed by the installed
tool binaries. No application services or existing compiler caches are changed.
"""
from pathlib import Path
import json
import os
import subprocess
import tempfile
import time

repo = Path(__file__).resolve().parents[1]
installed = Path(os.environ["CARAMEL_TOOLCHAIN_ROOT"]).resolve()
root = Path(tempfile.mkdtemp(prefix="caramel-compiler-profile-", dir="/private/tmp"))
print("Compiler profile: " + str(root), flush=True)
generator = root / "generate.cr"
generator.write_text('require ' + json.dumps(os.path.relpath(repo / "src/frappe/new_project", root)) + '\n' +
                     'require ' + json.dumps(os.path.relpath(repo / "src/frappe/resource_generator", root)) + '\n' + '''
project = Caramel::Frappe::NewProject.new(ARGV[0]).create("bookshelf", ARGV[1])
generator = Caramel::Frappe::ResourceGenerator.new(ARGV[0])
generator.generate(project, "Book", ["title:string", "author:string"])
generator.generate(project, "Person", ["name:string", "age:int32", "total:int64", "active:bool", "rating:float64?", "joined_at:time?"], plural: "people")
if ARGV[2] == "22"
  ('A'..'T').each { |letter| generator.generate(project, "Benchmark#{letter}", ["title:string", "description:string"]) }
end
''')
subprocess.run([str(repo / "scripts/crystal"), "build", str(generator), "-o", str(root / "generate")], cwd=repo, check=True)
report = {"complete": False, "scenarios": {}, "root": str(root)}
try:
    for count in (2, 22):
        directory = root / str(count)
        directory.mkdir()
        project = directory / "bookshelf"
        subprocess.run([str(root / "generate"), str(repo), str(project), str(count)], check=True)
        subprocess.run([str(repo / "scripts/shards"), "install", "--frozen"], cwd=project, check=True)
        prefix = directory / "toolchain"
        (prefix / "data").mkdir(parents=True)
        (prefix / "data/installs").symlink_to(installed / "data/installs", target_is_directory=True)
        (prefix / "bin").symlink_to(installed / "bin", target_is_directory=True)
        environment = {**os.environ, "CARAMEL_TOOLCHAIN_ROOT": str(prefix)}
        controller = project / "app/actions/home/show.cr"
        template = project / "app/views/home/index.html.ecr"
        stages = report["scenarios"][str(count)] = {}
        for stage in ("cold", "unchanged_warm", "template_edit", "controller_edit"):
            if stage == "template_edit":
                template.write_text(template.read_text() + "\n<!-- compiler-profile-template -->\n")
            elif stage == "controller_edit":
                controller.write_text(controller.read_text().replace('Caramel::Page.new("Welcome", content)', 'Caramel::Page.new("Welcome", content + "<!-- compiler-profile-controller -->")'))
            log = directory / (stage + ".log")
            command = [str(repo / "scripts/crystal"), "build", "src/bookshelf.cr", "-D", "caramel_development", "--stats", "--error-trace", "-o", str(directory / "application")]
            started = time.monotonic()
            with log.open("w") as output:
                result = subprocess.run(command, cwd=project, env=environment, stdout=output, stderr=subprocess.STDOUT, timeout=180)
            stages[stage] = {"elapsed_ms": (time.monotonic() - started) * 1000, "exit_code": result.returncode, "log": log.name}
            print(str(count) + " resources / " + stage + ": " + str(round(stages[stage]["elapsed_ms"])) + " ms", flush=True)
            result.check_returncode()
    report["complete"] = True
finally:
    (root / "report.json").write_text(json.dumps(report, indent=2) + "\n")
    print("Saved compiler profile: " + str(root / "report.json"), flush=True)
