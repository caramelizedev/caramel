#!/usr/bin/env python3
"""Exercise process-group cancellation and parent-pipe closure for frappe dev."""
from pathlib import Path
import os
import signal
import subprocess
import tempfile
import time

repo = Path(__file__).resolve().parents[1]
with tempfile.TemporaryDirectory(prefix="caramel-dev-child-", dir="/private/tmp") as temporary:
    root = Path(temporary)
    runner = root / "runner"
    subprocess.run([str(repo / "scripts/crystal"), "build", "spec/fixtures/dev_child_runner.cr", "-o", str(runner)], cwd=repo, check=True)
    child = subprocess.Popen([str(runner), "/bin/sh", "-c", "printf child-output; exit 7"], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    assert child.wait(timeout=8) == 7
    assert child.stdout.read() == b"child-output"
    child.stdin.close()
    print("PASS: command output and exit status", flush=True)

    # A deliberately TERM-resistant descendant must die with the parent lease.
    command = root / "descendant.py"
    command.write_text("import os,signal,time\nfrom pathlib import Path\nsignal.signal(signal.SIGTERM,signal.SIG_IGN)\nPath('descendant.pid').write_text(str(os.getpid()))\nwhile True: time.sleep(1)\n")
    child = subprocess.Popen([str(runner), "/usr/bin/python3", str(command)], cwd=root, stdin=subprocess.PIPE)
    try:
        deadline = time.monotonic() + 8
        while not (root / "descendant.pid").exists():
            assert time.monotonic() < deadline and child.poll() is None
            time.sleep(.03)
        pid = int((root / "descendant.pid").read_text())
        child.stdin.close()
        child.wait(timeout=8)
        deadline = time.monotonic() + 5
        while True:
            status = subprocess.run(["/bin/ps", "-p", str(pid), "-o", "stat="], text=True, capture_output=True).stdout.strip()
            if not status or status.startswith("Z"):
                break
            assert time.monotonic() < deadline, "owned descendant survived parent lease closure"
            time.sleep(.05)
        print("PASS: closed parent lease kills TERM-resistant descendants", flush=True)
    finally:
        if child.poll() is None:
            child.stdin.close()
            child.wait(timeout=8)
