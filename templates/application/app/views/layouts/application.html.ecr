<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= App::TITLE %></title>
  <link rel="stylesheet" href="/assets/app.css">
  <script src="/assets/htmx-4.0.0.min.js" defer></script>
  <script src="/assets/caramel-islands.js" defer></script>
  <script src="/assets/app.js" defer></script>
</head>
<body hx-boost:inherited="true" hx-target:inherited="#content" hx-swap:inherited="innerMorph" hx-headers:inherited="<%= {"X-CSRF-Token" => csrf_token}.to_json %>">
  <header class="site-header"><a href="/" class="brand"><span class="mark" aria-hidden="true">c.</span><%= App::TITLE %></a><span class="made-with">Made with Caramel</span></header>
  <main id="content"><%= body %></main>
  <footer>Make something worth opening.</footer>
</body>
</html>
