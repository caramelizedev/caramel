<a class="back" href="/books">← Your bookshelf</a>
<section class="form-page"><p class="eyebrow">MAKE ROOM FOR A GOOD BOOK</p><h1><%= title %></h1><p class="lede">Just the essentials. The story is inside.</p>
<form class="book-form" action="<%= action %>" method="post">
  <input type="hidden" name="_csrf" value="<%= csrf_token %>">
  <% unless method == "POST" %><input type="hidden" name="_method" value="<%= method %>"><% end %>
  <% unless book.errors.empty? %><div class="errors" role="alert" id="form-errors"><p>We need a little more detail.</p><ul><% book.errors.each do |error| %><li><%= error %></li><% end %></ul></div><% end %>
  <label for="book_title">Book title</label><input id="book_title" name="book[title]" value="<%= book.title %>" placeholder="A Wizard of Earthsea" maxlength="200" required autofocus<% unless book.errors.empty? %> aria-describedby="form-errors"<% end %>>
  <label for="book_author">Author</label><input id="book_author" name="book[author]" value="<%= book.author %>" placeholder="Ursula K. Le Guin" maxlength="200" required>
  <div class="actions"><button class="button" type="submit">Save book</button><a class="cancel" href="/books">Cancel</a></div>
</form></section>
