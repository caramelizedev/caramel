<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Bookshelf</title>
  <link rel="stylesheet" href="/assets/app.css">
  <script src="/assets/htmx-4.0.0.min.js" defer></script>
</head>
<body hx-boost:inherited="true" hx-target:inherited="#content" hx-swap:inherited="innerHTML">
  <header class="site-header"><a href="/books" class="brand"><span class="mark" aria-hidden="true">b.</span> Bookshelf</a><span class="made-with">Made with Caramel</span></header>
  <main id="content"><%= body %></main>
  <footer>A little space for the books that stay with you.</footer>
</body>
</html>
