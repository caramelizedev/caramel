#!/usr/bin/env python3
"""Prepare/review the fixed macOS DNS/port integration; apply requires root.

Certificate trust is installed separately as the user, never by the root helper.
No project code is executed by this installer.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import plistlib
import pwd
import re
import shutil
import socket
import stat
import subprocess
import tempfile
import time

REPO = Path(__file__).resolve().parents[1]
RECEIPT = Path('/Library/Application Support/Caramel/local-integration.json')
DESTINATIONS = {
    'relay': Path('/Library/PrivilegedHelperTools/dev.caramel.ports'),
    'plist': Path('/Library/LaunchDaemons/dev.caramel.ports.plist'),
    'resolver': Path('/etc/resolver/caramel'),
}

def digest(data):
    return hashlib.sha256(data).hexdigest()

def owned_file(path, uid, private=False):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_mode & (0o077 if private else 0o022):
        raise RuntimeError(f'Unexpected file ownership or permissions: {path}')
    return path.read_bytes()

def port_configuration(username):
    return {
        'Label': 'dev.caramel.ports', 'UserName': username,
        'ProgramArguments': ['/Library/PrivilegedHelperTools/dev.caramel.ports'],
        'Program': '/Library/PrivilegedHelperTools/dev.caramel.ports',
        'Sockets': {name: {'SockNodeName': '127.0.0.1', 'SockFamily': 'IPv4',
                           'SockServiceName': str(port), 'SockType': 'stream'}
                    for name, port in (('http', 80), ('https', 443))},
        'RunAtLoad': True, 'KeepAlive': True, 'ProcessType': 'Background',
        'ThrottleInterval': 5, 'AbandonProcessGroup': True,
        'StandardOutPath': '/dev/null', 'StandardErrorPath': '/dev/null',
    }

def prepare(bundle):
    if os.geteuid() == 0:
        raise RuntimeError('Prepare the installation as the ordinary installing user')
    user = pwd.getpwuid(os.getuid())
    relay = owned_file(REPO / 'bin/latte-port-relay', user.pw_uid)
    plist = port_configuration(user.pw_name)
    data = {'relay': relay, 'plist': plistlib.dumps(plist),
            'resolver': b'# Managed by Caramel Latte\nnameserver 127.0.0.1\nport 15353\n'}
    bundle.mkdir(mode=0o700)
    for name, content in data.items():
        path = bundle / name
        path.write_bytes(content)
        path.chmod(0o600)
    manifest = {'version': 1, 'uid': user.pw_uid, 'username': user.pw_name,
                'sha256': {key: digest(value) for key, value in data.items()}}
    (bundle / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    (bundle / 'manifest.json').chmod(0o600)
    print(json.dumps({'bundle': str(bundle), 'installs': {key: str(path) for key, path in DESTINATIONS.items()},
                      'runs_as': user.pw_name, 'sha256': manifest['sha256']}, indent=2))

def load_bundle(bundle):
    info = bundle.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o077 or info.st_uid == 0:
        raise RuntimeError('Installation bundle must be a private, user-owned directory')
    manifest = json.loads(owned_file(bundle / 'manifest.json', info.st_uid, True))
    if manifest.get('version') != 1 or manifest.get('uid') != info.st_uid:
        raise RuntimeError('Invalid installation manifest')
    user = pwd.getpwuid(info.st_uid)
    if manifest.get('username') != user.pw_name:
        raise RuntimeError('Installing account changed')
    data = {key: owned_file(bundle / key, info.st_uid, True) for key in DESTINATIONS}
    if manifest.get('sha256') != {key: digest(value) for key, value in data.items()}:
        raise RuntimeError('Installation artifact checksum mismatch')
    # Recreate privileged configuration from fixed values. Supplied plist and
    # resolver bytes are compared, never blindly interpreted as instructions.
    expected = port_configuration(user.pw_name)
    if plistlib.loads(data['plist']) != expected:
        raise RuntimeError('Port relay configuration differs from the fixed template')
    if data['resolver'] != b'# Managed by Caramel Latte\nnameserver 127.0.0.1\nport 15353\n':
        raise RuntimeError('Resolver configuration differs from the fixed scope')
    return manifest, data

def secure_parent(path):
    missing = []
    current = path
    while not current.exists():
        missing.append(current)
        current = current.parent
    # /etc is Apple's canonical alias; resolve it before checking destination
    # parents. All newly created and final directories must be root owned.
    for parent in reversed(missing):
        parent.mkdir(mode=0o755)
    for parent in (path.resolve(), *path.resolve().parents):
        info = parent.stat()
        if info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError(f'Unsafe system installation directory: {parent}')

def atomic_write(path, content, mode):
    secure_parent(path.parent)
    descriptor, temporary = tempfile.mkstemp(prefix='.caramel-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'wb') as output:
            os.fchmod(output.fileno(), mode)
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

def read_receipt():
    if not RECEIPT.exists() and not RECEIPT.is_symlink():
        return None
    return json.loads(owned_file(RECEIPT, 0, True))

def require_owned_files(receipt):
    for name, path in DESTINATIONS.items():
        if path.exists() or path.is_symlink():
            data = owned_file(path, 0)
            if digest(data) != receipt['sha256'][name]:
                raise RuntimeError(f'Owned installation changed; preserving it: {path}')

def job_description():
    result = subprocess.run(['/bin/launchctl', 'print', 'system/dev.caramel.ports'], capture_output=True, text=True)
    return result.stdout if result.returncode == 0 else None

def verify_job(description):
    expected = {'path': str(DESTINATIONS['plist']), 'program': str(DESTINATIONS['relay'])}
    for key, value in expected.items():
        found = re.findall(r'^\s*' + key + r' = (.+)$', description, re.MULTILINE)
        if found != [value]:
            raise RuntimeError('An existing launchd job with the same label is not owned by this installation')
    arguments = re.search(r'^\s*arguments = \{\n(.*?)^\s*\}', description, re.MULTILINE | re.DOTALL)
    if not arguments or arguments.group(1).strip() != str(DESTINATIONS['relay']):
        raise RuntimeError('The loaded port relay has unexpected arguments; it was preserved')

def reserve_ports():
    probes = []
    try:
        for port in (80, 443):
            probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            probes.append(probe)
            try:
                probe.bind(('127.0.0.1', port))
            except OSError as error:
                raise RuntimeError(f'Port {port} is occupied or unavailable; its service was preserved') from error
        return probes
    except Exception:
        for probe in probes:
            probe.close()
        raise

def await_job(uid):
    deadline = time.monotonic() + 5
    observed = None
    while time.monotonic() < deadline:
        description = job_description()
        if description:
            verify_job(description)
            pid = re.search(r'^\s*pid = (\d+)$', description, re.MULTILINE)
            if pid:
                process = subprocess.run(['/bin/ps', '-ww', '-p', pid.group(1), '-o', 'uid=,command='], capture_output=True, text=True)
                fields = process.stdout.strip().split(None, 1)
                if len(fields) == 2 and fields[0] == str(uid) and fields[1] == str(DESTINATIONS['relay']):
                    if observed == pid.group(1):
                        return
                    observed = pid.group(1)
        time.sleep(.3)
    raise RuntimeError('The unprivileged port relay did not become ready')

def remove_owned_files(receipt):
    require_owned_files(receipt)
    for path in DESTINATIONS.values():
        path.unlink(missing_ok=True)
    RECEIPT.unlink(missing_ok=True)

def apply(bundle):
    if os.geteuid() != 0:
        raise RuntimeError('Apply requires macOS administrator authorization')
    manifest, data = load_bundle(bundle)
    old = read_receipt()
    reservations = []
    if old:
        if old != manifest:
            raise RuntimeError('A different Caramel integration is installed; uninstall it explicitly first')
        require_owned_files(old)
        existing_job = job_description()
        if existing_job:
            verify_job(existing_job)
        else:
            reservations = reserve_ports()
    else:
        for path in DESTINATIONS.values():
            if path.exists() or path.is_symlink():
                raise RuntimeError(f'Existing configuration was preserved: {path}')
        if job_description():
            raise RuntimeError('An unowned launchd job already uses the Caramel label; it was preserved')
        reservations = reserve_ports()
    try:
        # Record ownership before individual writes so interruption is resumable.
        atomic_write(RECEIPT, json.dumps(manifest, indent=2).encode() + b'\n', 0o600)
        for name, path in DESTINATIONS.items():
            if not path.exists():
                atomic_write(path, data[name], 0o755 if name == 'relay' else 0o644)
        for probe in reservations:
            probe.close()
        reservations = []
        description = job_description()
        if description:
            verify_job(description)
        else:
            subprocess.run(['/bin/launchctl', 'bootstrap', 'system', str(DESTINATIONS['plist'])], check=True)
        await_job(manifest['uid'])
    except Exception:
        # A competing bind can still race the handoff to launchd. A fresh
        # failed transaction removes only its verified files/job; retries of
        # an existing installation preserve their receipt for repair.
        if not old:
            description = job_description()
            if description:
                try:
                    verify_job(description)
                except RuntimeError:
                    # Preserve a competing job while removing only the files
                    # created and fingerprinted by our failed transaction.
                    pass
                else:
                    subprocess.run(['/bin/launchctl', 'bootout', 'system/dev.caramel.ports'], check=True)
            remove_owned_files(manifest)
        raise
    finally:
        for probe in reservations:
            probe.close()
    print('Installed Caramel resolver and unprivileged standard-port relay.')

def uninstall():
    if os.geteuid() != 0:
        raise RuntimeError('Uninstall requires macOS administrator authorization')
    receipt = read_receipt()
    if not receipt:
        print('No owned system integration is installed.')
        return
    require_owned_files(receipt)
    description = job_description()
    if description:
        verify_job(description)
        subprocess.run(['/bin/launchctl', 'bootout', 'system/dev.caramel.ports'], check=True)
    remove_owned_files(receipt)
    print('Removed only the recorded Caramel resolver and relay. User certificate trust is managed separately.')

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('prepare').add_argument('bundle', type=Path)
    commands.add_parser('apply').add_argument('bundle', type=Path)
    commands.add_parser('uninstall')
    args = parser.parse_args()
    try:
        if args.command == 'prepare':
            prepare(args.bundle.absolute())
        elif args.command == 'apply':
            apply(args.bundle.absolute())
        else:
            uninstall()
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.CalledProcessError) as error:
        parser.exit(1, f'Caramel integration: {error}\n')

if __name__ == '__main__':
    main()
