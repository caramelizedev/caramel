#!/usr/bin/env python3
"""Check eval parsing and OpenSSL loading against the real managed compiler."""
from pathlib import Path
import subprocess
import sys

repo = Path(__file__).resolve().parent.parent
for source in ("puts 1", 'require "http"; puts 1'):
    result = subprocess.run([str(repo / "scripts/crystal"), "eval", source], cwd=repo, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if result.returncode or result.stdout.strip() != "1":
        print(result.stdout, file=sys.stderr)
        sys.exit("Managed Crystal eval regression")
print("Managed Crystal eval and OpenSSL loading: passed")
