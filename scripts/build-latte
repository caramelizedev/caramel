#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
mkdir -p "$ROOT/bin"
"$ROOT/scripts/crystal" build "$ROOT/src/latte.cr" --error-on-warnings -o "$ROOT/bin/latte"
"$ROOT/scripts/build-latte-menu"
"$ROOT/scripts/build-latte-relay"
