#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BIN="$ROOT/bin/install-local-integration"
if [ ! -x "$BIN" ] || [ -n "$(find "$ROOT/tools/installer" -name '*.swift' -newer "$BIN")" ]; then
  if [ "$(id -u)" -eq 0 ]; then echo 'Run scripts/build-installers as the installing user first.' >&2; exit 1; fi
  "$ROOT/scripts/build-installers" >&2
fi
exec "$BIN" "$@"
