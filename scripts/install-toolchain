#!/usr/bin/env python3
"""Install Caramel's pinned Apple Silicon tools into one private, durable prefix.

This component installs no system services, DNS, certificates, or databases.
It requires Apple's Command Line Tools (Python, clang and a macOS SDK).
"""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import runpy
import shutil
import stat
import subprocess
import sys
import tempfile

REPO = Path(__file__).resolve().parents[1]
RECEIPT = ".caramel-toolchain.json"
MISE_URL = "https://github.com/jdx/mise/releases/download/v2026.9.11/mise-v2026.9.11-macos-arm64"
MISE_SHA = "bbfd47ef65c2278c4e9ba09b523beb1019365a3c0b9c9fc60f686dc16f358e0f"
CRITICAL = [
    "bin/mise",
    "data/installs/github-crystal-lang-crystal/1.21.0/embedded/bin/crystal",
    "data/installs/github-crystal-lang-crystal/1.21.0/embedded/bin/shards",
    "data/installs/aqua-caddyserver-caddy/2.11.4/caddy",
    "data/installs/conda-postgresql/18.6/bin/postgres",
    "data/installs/conda-postgresql/18.6/bin/initdb",
    "data/installs/conda-postgresql/18.6/bin/pg_ctl",
    "data/installs/conda-postgresql/18.6/bin/psql",
    "data/installs/conda-openssl/3.6.4/bin/openssl",
    "data/installs/conda-openssl/3.6.4/lib/libssl.3.dylib",
    "data/installs/conda-openssl/3.6.4/lib/libcrypto.3.dylib",
    "data/installs/conda-pkgconf/3.0.7/bin/pkgconf",
    "data/installs/github-coredns-coredns/1.14.7/coredns",
]
ALIASES = {
    "bin/shards": "../data/installs/github-crystal-lang-crystal/1.21.0/embedded/bin/shards",
    "bin/pkg-config": "../data/installs/conda-pkgconf/3.0.7/bin/pkgconf",
}


def digest(path):
    with path.open("rb") as stream:
        checksum = hashlib.sha256()
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            checksum.update(chunk)
        return checksum.hexdigest()


def authored_payloads():
    # These are package-owned files, never read from the caller's application.
    compiler_entry = b'''#!/usr/bin/env python3
import os
from pathlib import Path
import runpy
root = Path(__file__).resolve().parents[1]
os.environ["CARAMEL_TOOLCHAIN_ROOT"] = str(root)
runpy.run_path(str(root / "launchers/crystal"), run_name="__main__")
'''
    return {
        "project/caramel-eval.toml": (REPO / "experiments/toolchain/project/caramel-eval.toml").read_bytes(),
        "project/mise.lock": (REPO / "experiments/toolchain/project/mise.lock").read_bytes(),
        "project/smoke.cr": (REPO / "experiments/toolchain/project/smoke.cr").read_bytes(),
        "toolchain-provider.py": (REPO / "experiments/toolchain/run-mise.py").read_bytes(),
        "launchers/crystal": (REPO / "scripts/crystal").read_bytes(),
        "launchers/shards": (REPO / "scripts/shards").read_bytes(),
        "bin/crystal": compiler_entry,
        "config/empty.toml": b"",
        "system-config/empty.toml": b"",
        "latte-darwin-arm64.json": (REPO / "tools/latte-darwin-arm64.json").read_bytes(),
    }


def owned_file(path):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
        raise RuntimeError("expected an owned regular file (no symlink): " + str(path))


def directory(root, relative):
    current = root
    for component in Path(relative).parts:
        current = current / component
        try:
            current.mkdir(mode=0o700)
        except FileExistsError:
            pass
        info = current.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            raise RuntimeError("expected an owned directory (no symlink): " + str(current))
    return current


def atomic_write(path, data, mode=0o600):
    fd, temporary = tempfile.mkstemp(prefix=".install-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
            os.fchmod(stream.fileno(), mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


class Installation:
    def __init__(self, root):
        root = Path(root).expanduser().absolute()
        if root.is_symlink():
            raise RuntimeError("installation root cannot be a symlink")
        self.root = root.resolve()
        self.lock = None
        self.payloads = authored_payloads()
        self.selection = {name: hashlib.sha256(data).hexdigest() for name, data in self.payloads.items()}
        self.state = None

    def __enter__(self):
        root = self.root
        if root.exists():
            info = root.lstat()
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
                raise RuntimeError("installation root must be an owned directory")
            children = set(p.name for p in root.iterdir())
            if RECEIPT not in children and children - {".install.lock"}:
                raise RuntimeError("refusing a nonempty directory without a Caramel receipt")
            if children and info.st_mode & 0o077:
                raise RuntimeError("installation root must be private (mode 0700)")
        else:
            root.mkdir(mode=0o700, parents=True)
        root.chmod(0o700)
        try:
            fd = os.open(root / ".install.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
            self.lock = os.fdopen(fd, "r+")
            owned_file(root / ".install.lock")
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise RuntimeError("another Caramel toolchain installer is already running")
            path = root / RECEIPT
            if path.exists() or path.is_symlink():
                owned_file(path)
                self.state = json.loads(path.read_text())
                if not isinstance(self.state, dict):
                    raise RuntimeError("installation receipt must be an object")
                if self.state.get("root") != str(root):
                    raise RuntimeError("installation was moved; install into a fresh prefix")
                if self.state.get("version") != 1 or self.state.get("selection") != self.selection:
                    raise RuntimeError("installation receipt differs from this toolchain release")
                if self.state.get("status") not in ("installing", "complete"):
                    raise RuntimeError("unrecognized installation state")
            else:
                self.state = {"version": 1, "root": str(root), "selection": self.selection, "status": "installing"}
                self.save()
            return self
        except BaseException:
            if self.lock:
                self.lock.close()
                self.lock = None
            raise

    def __exit__(self, *args):
        if self.lock:
            self.lock.close()
            self.lock = None

    def save(self):
        atomic_write(self.root / RECEIPT, (json.dumps(self.state, indent=2, sort_keys=True) + "\n").encode())

    def prepare(self):
        # Validate known writable roots before a provider can follow any of them.
        for relative in ("bin", "data", "cache", "state", "config", "system-config", "system-data", "xdg-cache", "xdg-config", "xdg-data", "xdg-state", "mamba", "crystal-cache", "data/installs", "project", "launchers"):
            directory(self.root, relative)
        for name, data in self.payloads.items():
            path = self.root / name
            directory(self.root, str(Path(name).parent))
            if path.exists() or path.is_symlink():
                owned_file(path)
                if path.read_bytes() != data:
                    raise RuntimeError("authored toolchain file differs; preserved: " + name)
            else:
                atomic_write(path, data, 0o700 if name.startswith(("bin/", "launchers/")) else 0o600)

    def artifact_hashes(self):
        hashes = {}
        for name in CRITICAL:
            path = self.root / name
            # Validate parent components too, while permitting package-owned
            # symlinks elsewhere in the native distribution.
            for parent in path.parents:
                if parent == self.root:
                    break
                if parent.is_symlink():
                    raise RuntimeError("artifact parent cannot be a symlink: " + str(parent))
            owned_file(path)
            hashes[name] = digest(path)
        return hashes

    def verify_aliases(self):
        for name, target in ALIASES.items():
            path = self.root / name
            if not path.is_symlink() or path.lstat().st_uid != os.getuid() or os.readlink(path) != target:
                raise RuntimeError("toolchain alias verification failed: " + name)

    def verified(self):
        if self.state["status"] != "complete":
            return False
        if set(self.state.get("artifacts", {})) != set(CRITICAL):
            raise RuntimeError("toolchain artifact inventory verification failed")
        # Verification must never repair or download, including altered config.
        for name, data in self.payloads.items():
            path = self.root / name
            owned_file(path)
            if path.read_bytes() != data:
                raise RuntimeError("toolchain configuration verification failed: " + name)
        if self.artifact_hashes() != self.state["artifacts"]:
            raise RuntimeError("toolchain artifact verification failed; preserve this prefix for inspection")
        self.verify_aliases()
        return True

    def complete(self):
        self.verify_aliases()
        self.state["artifacts"] = self.artifact_hashes()
        self.state["status"] = "complete"
        self.save()


def check_platform():
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        raise RuntimeError("this toolchain supports Apple Silicon macOS")
    for args in (["/usr/bin/xcrun", "--find", "clang"], ["/usr/bin/xcrun", "--show-sdk-path"]):
        result = subprocess.run(args, check=True, capture_output=True, text=True, timeout=15)
        if not Path(result.stdout.strip()).exists():
            raise RuntimeError("Apple Command Line Tools and a usable macOS SDK are required")


def verify_native_command(root, command, expected, env):
    result = subprocess.run([str(arg) for arg in command], cwd=root,
                            env={**env, "DYLD_PRINT_LIBRARIES": "1"},
                            capture_output=True, text=True, check=True, timeout=20)
    if not result.stdout.startswith(expected):
        raise RuntimeError("native tool version/output differs: " + str(command[0]))
    libraries = []
    for line in result.stderr.splitlines():
        match = re.match(r"^dyld\[\d+\]: <[0-9A-Fa-f-]+> (/.+)$", line)
        if not match:
            continue
        path = str(Path(match.group(1)).resolve())
        if not path.startswith((str(root.resolve()) + "/", "/usr/lib/", "/System/Library/", "/Library/Apple/System/Library/")):
            raise RuntimeError("native tool loaded a library outside Caramel or macOS: " + path)
        libraries.append(path)
    if not libraries:
        raise RuntimeError("native library evidence is unavailable: " + str(command[0]))
    return {"command": [str(arg) for arg in command], "output": result.stdout.strip(), "libraries": sorted(set(libraries))}


def verify_native_tools(root, env):
    installs = root / "data/installs"
    commands = [
        ([installs / "github-crystal-lang-crystal/1.21.0/embedded/bin/crystal", "--version"], "Crystal 1.21.0"),
        ([installs / "github-crystal-lang-crystal/1.21.0/embedded/bin/shards", "--version"], "Shards 0.20.0"),
        ([installs / "aqua-caddyserver-caddy/2.11.4/caddy", "version"], "v2.11.4"),
        ([installs / "conda-postgresql/18.6/bin/postgres", "--version"], "postgres (PostgreSQL) 18.6"),
        ([installs / "conda-postgresql/18.6/bin/initdb", "--version"], "initdb (PostgreSQL) 18.6"),
        ([installs / "conda-postgresql/18.6/bin/pg_ctl", "--version"], "pg_ctl (PostgreSQL) 18.6"),
        ([installs / "conda-postgresql/18.6/bin/psql", "--version"], "psql (PostgreSQL) 18.6"),
        ([installs / "conda-openssl/3.6.4/bin/openssl", "version"], "OpenSSL 3.6.4"),
        ([installs / "conda-pkgconf/3.0.7/bin/pkgconf", "--version"], "3.0.7"),
        ([installs / "github-coredns-coredns/1.14.7/coredns", "-version"], "CoreDNS-1.14.7"),
        ([root / "project/smoke"], '{"message":"Caramel","regex":"0"}'),
    ]
    evidence = [verify_native_command(root, command, expected, env) for command, expected in commands]
    atomic_write(root / "project/native-verification.json", (json.dumps(evidence, indent=2) + "\n").encode())
    return evidence


def install_payloads(installation, mise_binary=None):
    root = installation.root
    mise = root / "bin/mise"
    if not mise.exists() and not mise.is_symlink():
        with tempfile.TemporaryDirectory(prefix=".mise-download-", dir=root) as temporary:
            downloaded = Path(temporary) / "mise"
            if mise_binary:
                shutil.copyfile(mise_binary, downloaded)
            else:
                subprocess.run(["/usr/bin/curl", "--fail", "--silent", "--show-error", "--location", "--proto", "=https", "--proto-redir", "=https", "--connect-timeout", "15", "--max-time", "180", "--retry", "2", "--output", str(downloaded), MISE_URL], check=True, timeout=600)
            if digest(downloaded) != MISE_SHA:
                raise RuntimeError("mise checksum verification failed")
            atomic_write(mise, downloaded.read_bytes(), 0o700)
    owned_file(mise)
    if digest(mise) != MISE_SHA:
        raise RuntimeError("existing mise checksum verification failed; preserved")
    provider = runpy.run_path(str(root / "toolchain-provider.py"))
    env = provider["build_environment"](root)
    for args in (["trust", str(root / "project/caramel-eval.toml")], ["install", "--locked"]):
        subprocess.run([str(mise), *args], cwd=root / "project", env=env, check=True, timeout=900)
    for name, target in ALIASES.items():
        path = root / name
        if path.exists() or path.is_symlink():
            if not path.is_symlink() or os.readlink(path) != target:
                raise RuntimeError("tool alias conflicts with existing file: " + name)
        else:
            path.symlink_to(target)
    env["CARAMEL_TOOLCHAIN_ROOT"] = str(root)
    subprocess.run([sys.executable, str(REPO / "scripts/install-latte-tools")], env=env, check=True, timeout=650)
    # Compile and execute against the final prefix; moving conda installations
    # after linking is intentionally unsupported.
    subprocess.run([str(root / "bin/crystal"), "build", str(root / "project/smoke.cr"), "-o", str(root / "project/smoke")], cwd=root / "project", env=env, check=True, timeout=180)
    subprocess.run([str(root / "project/smoke")], cwd=root, env=env, check=True, timeout=15)
    verify_native_tools(root, env)


def install(root, offline=False, mise_binary=None, preflight=True):
    if preflight:
        check_platform()
    # Do not claim or create a prefix when offline installation is impossible.
    if offline and not (Path(root).expanduser() / RECEIPT).is_file():
        raise RuntimeError("offline use requires a completed verified installation")
    with Installation(root) as installation:
        if installation.verified():
            print("Verified installed Caramel toolchain: " + str(installation.root))
            return
        if offline:
            raise RuntimeError("offline use requires a completed verified installation")
        installation.prepare()
        install_payloads(installation, mise_binary=mise_binary)
        # Provider commands must not rewrite the authored selection.
        installation.prepare()
        installation.complete()
        print("Installed and verified Caramel toolchain: " + str(installation.root))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, required=True, help="empty or previously claimed final installation directory")
    parser.add_argument("--offline", action="store_true", help="verify and reuse a completed installation without downloads")
    parser.add_argument("--mise-binary", type=Path, help="reuse a local mise binary after verifying the pinned SHA-256")
    args = parser.parse_args()
    install(args.root, offline=args.offline, mise_binary=args.mise_binary)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("Installation interrupted. Rerun with the same --root to resume.", file=sys.stderr)
        sys.exit(130)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        sys.exit("install-toolchain: " + str(error))
