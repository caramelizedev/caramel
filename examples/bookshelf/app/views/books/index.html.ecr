<section class="heading"><div><p class="eyebrow">THE PERSONAL LIBRARY</p><h1>Your next chapter.</h1><p class="lede">Good books deserve a place of their own.</p></div><a class="button" href="/books/new">+ Add a book</a></section>
<section class="collection" aria-labelledby="collection-heading">
  <div class="collection-bar"><h2 id="collection-heading">On your shelf</h2><span><%= books.size %> <%= books.size == 1 ? "book" : "books" %></span></div>
  <% if books.empty? %>
    <div class="empty-state"><div class="book-symbol" aria-hidden="true">▤</div><h3>A shelf full of possibility.</h3><p>Start with a favorite, a recommendation,<br>or the one you keep meaning to read.</p><a href="/books/new">Add your first book <span aria-hidden="true">→</span></a></div>
  <% else %>
    <div class="book-grid">
      <% books.each_with_index do |book, index| %>
        <a class="book-card tone-<%= index % 4 %>" href="/books/<%= book.id %>"><div class="book-cover"><span class="cover-label">THE BOOKSHELF COLLECTION</span><h3><%= book.title %></h3><span class="cover-author"><%= book.author %></span><span class="cover-number"><%= (index + 1).to_s.rjust(2, '0') %></span></div><div class="book-caption"><span><%= book.title %></span><span aria-hidden="true">↗</span></div><p><%= book.author %></p></a>
      <% end %>
    </div>
  <% end %>
</section>
