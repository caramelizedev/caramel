#!/usr/bin/env python3
"""Run Latte's managed PostgreSQL integration checks in one fresh owned root."""

from __future__ import annotations

import argparse
from datetime import datetime
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


REPO = Path(__file__).resolve().parents[1]


def owned_directory(path: Path) -> None:
    path.mkdir(mode=0o700, parents=True, exist_ok=False)
    path.chmod(0o700)


def owned_postgres_pid(data: Path, pid_file: Path, postgres: Path) -> bool:
    """Only let cleanup signal the exact process started in this fresh root."""
    try:
        stat = pid_file.lstat()
        if not stat or not pid_file.is_file() or pid_file.is_symlink():
            return False
        if stat.st_uid != os.getuid() or stat.st_mode & 0o077:
            return False
        lines = pid_file.read_text().splitlines()
        if len(lines) < 3 or lines[1].strip() != str(data):
            return False
        pid = int(lines[0].strip())
        postmaster_start = int(lines[2].strip())
        snapshot = subprocess.run(
            ["/bin/ps", "-ww", "-p", str(pid), "-o", "uid=,lstart=,command="],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
            timeout=2,
        )
        fields = snapshot.stdout.strip().split(None, 6)
        if snapshot.returncode != 0 or len(fields) != 7 or int(fields[0]) != os.getuid():
            return False
        process_start = datetime.strptime(" ".join(fields[1:6]), "%a %b %d %H:%M:%S %Y").timestamp()
        if abs(process_start - postmaster_start) > 1:
            return False
        command = fields[6]
        expected = f"{postgres} -D {data}"
        return command == expected or command.startswith(expected + " ")
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        return False


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--keep-on-failure", action="store_true")
    args = parser.parse_args()

    toolchain_root = os.environ.get("CARAMEL_TOOLCHAIN_ROOT")
    if not toolchain_root:
        print("Set CARAMEL_TOOLCHAIN_ROOT to the pinned toolchain root.", file=sys.stderr)
        return 2
    toolchain = Path(toolchain_root).resolve()
    pg = toolchain / "data/installs/conda-postgresql/18.6/bin"
    if not (pg / "initdb").is_file() or not (pg / "pg_ctl").is_file():
        print("Pinned PostgreSQL 18.6 tools are unavailable under CARAMEL_TOOLCHAIN_ROOT.", file=sys.stderr)
        return 2

    root = Path(tempfile.mkdtemp(prefix="caramel-latte-postgres-", dir="/private/tmp"))
    root.chmod(0o700)
    project = root / "project"
    project.mkdir(mode=0o700)
    environment = os.environ.copy()
    environment.update({
        "CARAMEL_TOOLCHAIN_ROOT": str(toolchain),
        "CARAMEL_LATTE_ROOT": str(root),
        "CARAMEL_LATTE_PROJECT": str(project),
        "LC_ALL": "C",
    })
    # Do not inherit caller libpq defaults into the newly owned cluster.
    for key in tuple(environment):
        if key.startswith("PG") or key.startswith("CARAMEL_LATTE_"):
            environment.pop(key, None)
    environment.update({
        "CARAMEL_TOOLCHAIN_ROOT": str(toolchain),
        "CARAMEL_LATTE_ROOT": str(root),
        "CARAMEL_LATTE_PROJECT": str(project),
        "LC_ALL": "C",
    })
    command = [str(REPO / "scripts/crystal"), "spec", "spec/latte_integration/postgres_spec.cr", "--error-trace"]
    try:
        result = subprocess.run(command, cwd=REPO, env=environment, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        print("PostgreSQL integration exceeded its 180-second budget; cleaning up owned state.", file=sys.stderr)
        result = subprocess.CompletedProcess(command, 124)
    except KeyboardInterrupt:
        print("PostgreSQL integration interrupted; cleaning up owned state.", file=sys.stderr)
        result = subprocess.CompletedProcess(command, 130)
    except OSError as error:
        print("Could not launch PostgreSQL integration: " + str(error), file=sys.stderr)
        result = subprocess.CompletedProcess(command, 127)

    data = root / "services/postgres/18/data"
    stopped = True
    pid_file = data / "postmaster.pid"
    if pid_file.exists():
        # This path was just created by this invocation; no external cluster
        # is ever probed or stopped by the cleanup block. Verify the PID and
        # full PostgreSQL executable/data identity before invoking pg_ctl.
        if not owned_postgres_pid(data, pid_file, pg / "postgres"):
            stopped = False
            print("Refusing to stop an unverified PostgreSQL PID; preserving " + str(root), file=sys.stderr)
        else:
            try:
                pid = int(pid_file.read_text().splitlines()[0])
                stop = subprocess.run(
                    [str(pg / "pg_ctl"), "-D", str(data), "-m", "fast", "-w", "stop"],
                    cwd=REPO,
                    env=environment,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE,
                    text=True,
                    timeout=30,
                )
                stopped = False
                if stop.returncode == 0 and not pid_file.exists():
                    try:
                        os.kill(pid, 0)
                    except ProcessLookupError:
                        stopped = True
                    except PermissionError:
                        pass
            except (OSError, ValueError, IndexError, subprocess.SubprocessError) as error:
                stopped = False
                print("Owned PostgreSQL cleanup failed: " + str(error), file=sys.stderr)
        if not stopped:
            print("Owned PostgreSQL did not stop; preserving " + str(root), file=sys.stderr)

    if stopped and (result.returncode == 0 or not args.keep_on_failure):
        shutil.rmtree(root)
    else:
        print("Preserved owned integration root: " + str(root), file=sys.stderr)
    return result.returncode if stopped else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, subprocess.SubprocessError) as error:
        print("check-latte-postgres: " + str(error), file=sys.stderr)
        raise SystemExit(1)
