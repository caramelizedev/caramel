<a class="back" href="/books">← Your bookshelf</a>
<article class="detail"><p class="eyebrow">FROM YOUR COLLECTION</p><h1><%= book.title %></h1><p class="lede">by <%= book.author %></p><div class="actions"><a class="button" href="/books/<%= book.id %>/edit">Edit book</a><form method="post" action="/books/<%= book.id %>"><input type="hidden" name="_csrf" value="<%= csrf_token %>"><input type="hidden" name="_method" value="DELETE"><button class="button button-quiet" type="submit">Remove from shelf</button></form></div></article>
